---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
---


<html lang="en" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/assets/logo/lsd_logo.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Leng Sovandara — Full-Stack & Mobile Developer</title>
        <meta name="description" content="Portfolio of Leng Sovandara — a Full-Stack & Mobile Developer specializing in React, Next.js, and Flutter. Based in Cambodia, building high-performance digital products." />
        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Leng Sovandara — Full-Stack & Mobile Developer" />
        <meta property="og:description" content="Portfolio of Leng Sovandara — a Full-Stack & Mobile Developer specializing in React, Next.js, and Flutter." />
        <meta property="og:image" content="/assets/img/dara.jpg" />
        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Leng Sovandara — Full-Stack & Mobile Developer" />
        <meta name="twitter:description" content="Full-Stack & Mobile Developer specializing in React, Next.js, and Flutter." />
        <meta name="twitter:image" content="/assets/img/dara.jpg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preconnect" href="https://cdn.jsdelivr.net" />
        <link rel="preload" href="https://cdn.jsdelivr.net/npm/remixicon@3.0.0/fonts/remixicon.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@3.0.0/fonts/remixicon.css" /></noscript>
        <link rel="preload" href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:ital,wght@0,100..700;1,100..700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:ital,wght@0,100..700;1,100..700&display=swap" /></noscript>
        <script is:inline>
          (function () {
            try {
              var saved = localStorage.getItem('theme');
              var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
              var theme = saved || (prefersDark ? 'dark' : 'light');
              document.documentElement.setAttribute('data-theme', theme);
              if (theme === 'dark') {
                document.documentElement.classList.add('dark');
              } else {
                document.documentElement.classList.remove('dark');
              }
            } catch (e) {}
          })();
        </script>
    </head>
    <body class="min-h-screen overflow-x-hidden bg-[#0b1220] text-gray-100">
        <Header />
        <main class="bg-[#0b1220] focus:outline-none" tabindex="-1">
            <slot />
        </main>
        <Footer />
    </body>
